{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "jsxImportSource": "@opentui/solid"
  },
  "include": [
    "src/**/*",
    "build.ts",
    "test/**/*.ts"
  ]
}