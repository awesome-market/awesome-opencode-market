<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.opencode-market.diagnose</string>

	<!-- 入口是系统卷上的守护循环 shim —— 前台常驻，进程内自跑节拍/重试。
	     launchd 仅作登录启动器；保活（崩溃重启）由第三方程序负责 -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/terry/.local/share/opencode-market/bin/ai-diagnose-agent.sh</string>
	</array>

	<key>RunAtLoad</key>
	<true/>

	<key>EnvironmentVariables</key>
	<dict>
		<!-- clone/push 不依赖开发 checkout —— 外置卷未挂载时整条链仍可运行 -->
		<key>MARKET_GIT_URL</key>
		<string>https://github.com/terry2010/awesome-opencode-market.git</string>
		<!-- 本机 git 代理覆盖：~/.gitconfig 的 LAN 代理在守护上下文不可达，
		     回环代理任何上下文都通。shim 把它翻译成 GIT_CONFIG_* 注入 -->
		<key>MARKET_GIT_PROXY</key>
		<string>http://127.0.0.1:7890</string>
	</dict>

	<!-- 批量任务：不抢前台时延 -->
	<key>ProcessType</key>
	<string>Background</string>
	<key>Nice</key>
	<integer>10</integer>
	<key>LowPriorityIO</key>
	<true/>

	<!-- 脚本自身按 5MB 滚动截断这两个文件 -->
	<key>StandardOutPath</key>
	<string>/Users/terry/Library/Logs/opencode-market/ai-diagnose.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/terry/Library/Logs/opencode-market/ai-diagnose.err.log</string>
</dict>
</plist>
